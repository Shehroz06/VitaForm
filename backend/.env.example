ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://career_os:career_os@localhost:5432/career_os
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=["groq","openrouter"]
AI_MAX_RETRIES=2

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# EMAIL_PROVIDER: console (default, dev-only -- logs instead of sending),
# smtp (any standard SMTP endpoint), or gmail (shorthand for SMTP against
# Gmail -- set SMTP_USERNAME to your Gmail address and SMTP_PASSWORD to a
# 16-character app password from https://myaccount.google.com/apppasswords,
# NOT your normal Gmail password; requires 2-Step Verification enabled).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=AI Career Platform

CORS_ORIGINS=["http://localhost:3000"]
# Host-header allowlist (TrustedHostMiddleware) -- must include the real
# domain(s) in production, or every request gets rejected.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

API_BASE_URL=http://localhost:8000/api/v1
# Base URL of the frontend app -- used to build the links sent in
# verification/reset emails. Get this wrong in production and every user
# gets emailed a localhost link.
FRONTEND_BASE_URL=http://localhost:3000

EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=storage/local
MAX_AVATAR_SIZE_MB=5
MAX_ATTACHMENT_SIZE_MB=10

S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
