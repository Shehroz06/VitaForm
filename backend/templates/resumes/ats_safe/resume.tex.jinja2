\BLOCK{if item.description}\VAR{item.description | format_description}\BLOCK{endif}
\BLOCK{if item.url}\small\href{\VAR{item.url | latex_safe_url}}{\VAR{item.url | latex_escape}}\normalsize\\
\BLOCK{endif}
