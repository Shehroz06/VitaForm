% The rule sits 2pt below the title and the vspace after it nets back to
% *zero* extra pull (matching the +2pt push-down, not overshooting it) --
% \titlespacing's "after" value below is the only thing controlling the
% gap to the next line. A larger negative pull here (this used to be
% -4pt) can exceed that "after" value at tight density/compact spacing,
% dragging the rule up into the following text instead of under the title.
\titleformat{\section}{\bfseries\fontsize{\VAR{(body_pt + 1.5) | round(1)}}{\VAR{(body_pt + 3) | round(1)}}\selectfont}{}{0em}{}[\vspace{2pt}\titlerule\vspace{-2pt}]
\titlespacing{\section}{0pt}{\VAR{section_gap_pt}pt}{\VAR{section_after_gap_pt}pt}

\newcommand{\resumeSubheading}[4]{
  \vspace{\VAR{item_sep_pt}pt}
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#1} & #2 \\
    \textit{\small #3} & \textit{\small #4} \\
  \end{tabular*}\vspace{-2pt}
}

\newcommand{\resumeEntryHeading}[2]{
  \vspace{\VAR{item_sep_pt}pt}
  \begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}
    \textbf{#1} & #2 \\
  \end{tabular*}
}

\begin{document}
\fontsize{\VAR{body_pt}}{\VAR{(body_pt * 1.18) | round(2)}}\selectfont

\begin{center}
  {\fontsize{\VAR{name_pt}}{\VAR{(name_pt * 1.1) | round(2)}}\selectfont\bfseries \VAR{full_name | latex_escape}} \\
  \vspace{2pt}
  \small
  \BLOCK{set contact_parts = []}
  \BLOCK{if contact_visibility.location and profile.location}
    \BLOCK{set _ = contact_parts.append(profile.location | latex_escape)}
  \BLOCK{endif}
  \BLOCK{if contact_visibility.phone and profile.phone}
    \BLOCK{set _ = contact_parts.append(profile.phone | latex_escape)}
  \BLOCK{endif}
  \BLOCK{if contact_visibility.email}
    \BLOCK{set _ = contact_parts.append("\\href{mailto:" ~ (email | latex_safe_url) ~ "}{" ~ (email | latex_escape) ~ "}")}
  \BLOCK{endif}
  \BLOCK{if contact_visibility.linkedin and profile.linkedin_url}
    \BLOCK{set _ = contact_parts.append("\\href{" ~ (profile.linkedin_url | latex_safe_url) ~ "}{LinkedIn}")}
  \BLOCK{endif}
  \BLOCK{if contact_visibility.github and profile.github_url}
    \BLOCK{set _ = contact_parts.append("\\href{" ~ (profile.github_url | latex_safe_url) ~ "}{GitHub}")}
  \BLOCK{endif}
  \BLOCK{if contact_visibility.website and profile.website_url}
    \BLOCK{set _ = contact_parts.append("\\href{" ~ (profile.website_url | latex_safe_url) ~ "}{Portfolio}")}
  \BLOCK{endif}
  \VAR{contact_parts | join(" $|$ ")}
\end{center}

\BLOCK{for section in sections}
\BLOCK{if section.type == "summary"}
\section*{\VAR{section.title | latex_escape}}
\VAR{section.text | format_paragraph}

\BLOCK{elif section.type == "education"}
\section*{\VAR{section.title | latex_escape}}
\BLOCK{for item in section.entries}
\resumeSubheading
  {\VAR{item.institution_name | latex_escape}}
  {\VAR{item.start_date.strftime("%b %Y") if item.start_date else ""} -- \VAR{"Present" if item.is_current else (item.end_date.strftime("%b %Y") if item.end_date else "")}}
  {\VAR{item.degree | latex_escape}\BLOCK{if item.field_of_study}, \VAR{item.field_of_study | latex_escape}\BLOCK{endif}\BLOCK{if item.grade} \textperiodcentered\ \VAR{item.grade | latex_escape}\BLOCK{endif}}
  { }
\BLOCK{if item.description}\VAR{item.description | format_description}\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{elif section.type == "experience"}
\section*{\VAR{section.title | latex_escape}}
\BLOCK{for item in section.entries}
\resumeSubheading
  {\VAR{item.company_name | latex_escape}}
  {\BLOCK{if item.location}\VAR{item.location | latex_escape}\BLOCK{endif}}
  {\VAR{item.job_title | latex_escape}}
  {\VAR{item.start_date.strftime("%b %Y") if item.start_date else ""} -- \VAR{"Present" if item.is_current else (item.end_date.strftime("%b %Y") if item.end_date else "")}}
\BLOCK{if item.description}\VAR{item.description | format_description}\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{elif section.type == "projects"}
\section*{\VAR{section.title | latex_escape}}
\BLOCK{for item in section.entries}
\resumeEntryHeading
  {\VAR{item.title | latex_escape}\BLOCK{if item.role} \textperiodcentered\ \textit{\small \VAR{item.role | latex_escape}}\BLOCK{endif}}
  {\small \BLOCK{if item.repository_url}\href{\VAR{item.repository_url | latex_safe_url}}{GitHub}\BLOCK{endif}\BLOCK{if item.repository_url and item.demo_url} \textperiodcentered\ \BLOCK{endif}\BLOCK{if item.demo_url}\href{\VAR{item.demo_url | latex_safe_url}}{Live}\BLOCK{endif}\normalsize}
\BLOCK{if item.description}\VAR{item.description | format_description}\BLOCK{endif}
\BLOCK{if item.skills}\small\textit{\VAR{item.skills | map(attribute="name") | map("latex_escape") | join(", ")}}\normalsize\\
\BLOCK{endif}
\BLOCK{endfor}

\BLOCK{elif section.type == "skills"}
\section*{\VAR{section.title | latex_escape}}
\VAR{section.entries | map(attribute="name") | map("latex_escape") | join(" $\\bullet$ ")}

\BLOCK{elif section.type == "certifications"}
\section*{\VAR{section.title | latex_escape}}
\BLOCK{for item in section.entries}
\resumeEntryHeading
  {\VAR{item.name | latex_escape} \textperiodcentered\ \textit{\small \VAR{item.issuing_organization | latex_escape}}}
  {\VAR{item.issue_date.strftime("%b %Y") if item.issue_date else ""}}
\BLOCK{endfor}

\BLOCK{elif section.type == "achievements"}
\section*{\VAR{section.title | latex_escape}}
